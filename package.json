{
	"name": "backend",
	"version": "0.0.1",
	"description": "A socket server",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc --noEmit && esbuild src/app/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js --alias:@=./src --packages=external",
		"dev": "tsx watch --env-file .env src/app/index.ts",
		"start": "node dist/index.js",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"license": "UNLICENSED",
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@t3-oss/env-core": "^0.13.11",
		"@types/cors": "^2.8.19",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"express": "^5.2.1",
		"postgres": "^3.4.9",
		"redis": "^5.12.1",
		"socket.io": "^4.8.3",
		"unique-names-generator": "^4.7.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@playwright/test": "^1.60.0",
		"@types/express": "^5.0.6",
		"@types/node": "^25.9.1",
		"drizzle-kit": "^0.31.10",
		"esbuild": "^0.28.0",
		"esbuild-register": "^3.6.0",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.7"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
